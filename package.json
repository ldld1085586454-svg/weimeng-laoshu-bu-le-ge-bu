{
  "name": "sheep-game-development",
  "version": "0.13.0",
  "private": true,
  "description": "Unified 2022-style development reconstruction: playable rounds, rewards, social, native WeChat adapter and loopback server; not production.",
  "type": "commonjs",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node tools/start-full.js",
    "online:serve": "node services/online/server.js",
    "online:test": "node --test tests/product-online-server.test.js tests/product-online-client.test.js tests/product-progress.test.js tests/product-online-ui.test.js tests/product-online-e2e.test.js",
    "build": "node tools/build-full.js",
    "test": "node tools/run-tests.js",
    "generate": "node tools/generate.js",
    "benchmark": "node tools/benchmark.js",
    "verify": "node tools/verify.js",
    "probe": "node tools/build-probe.js",
    "review:stress": "node tools/review-stress.js",
    "check": "node tools/check.js",
    "check:full": "node tools/check.js --full",
    "integrity": "node tools/verify-package.js",
    "play:build": "node tools/build-play.js",
    "play:stress": "node tools/play-stress.js",
    "serve": "node tools/serve-play.js",
    "commerce:test": "node --test tests/commerce.test.js",
    "commerce:build": "node tools/build-commerce.js",
    "integration:build": "node tools/build-integration.js",
    "integration:test": "node --test tests/integration-round.test.js tests/integration-controller.test.js tests/integration-provider.test.js tests/integration-ui.test.js",
    "integration:serve": "node tools/serve-integration.js",
    "full:build": "node tools/build-full.js",
    "full:check": "node tools/check-full.js",
    "full:serve": "node tools/start-full.js",
    "full:stress": "node tools/full-stress.js",
    "full:release-gate": "node tools/release-gate-full.js"
  }
}
